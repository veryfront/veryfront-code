{
  "name": "@veryfront/ext-claude-code-agent",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "veryfront": {
    "extension": true,
    "activation": "explicit",
    "contracts": {
      "provides": ["ClaudeCodeAgentRuntime"]
    },
    "capabilities": [
      { "type": "fs:read" },
      { "type": "fs:write" },
      { "type": "env:read" },
      { "type": "net:outbound", "hosts": ["*"] },
      { "type": "process:spawn" }
    ]
  },
  "imports": {
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.2.37",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing/bdd": "jsr:@std/testing@1.0.17/bdd",
    "veryfront/extensions": "../../src/extensions/index.ts",
    "veryfront/workflow/claude-code/runtime": "../../src/workflow/claude-code/runtime-contract.ts"
  },
  "tasks": {
    "check": "deno check --frozen src/index.ts src/*.test.ts",
    "test": "deno test --frozen --allow-all src/"
  }
}
