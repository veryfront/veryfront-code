{
  "name": "@veryfront/ext-blob-s3",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "veryfront": {
    "extension": true,
    "activation": "explicit",
    "contracts": {
      "provides": ["BlobStorage"]
    },
    "capabilities": [
      { "type": "net:outbound", "hosts": ["*"] },
      {
        "type": "env:read",
        "keys": [
          "AWS_LAMBDA_BENCHMARK_MODE",
          "AWS_LAMBDA_FUNCTION_NAME",
          "AWS_LAMBDA_MAX_CONCURRENCY",
          "AWS_LAMBDA_NODEJS_NO_GLOBAL_AWSLAMBDA",
          "AWS_NEW_RETRIES_2026",
          "AWS_SDK_JS_NODE_VERSION_SUPPORT_WARNING_DISABLED",
          "SMITHY_NEW_RETRIES_2026",
          "_X_AMZN_TRACE_ID"
        ]
      }
    ]
  },
  "imports": {
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@3.980.0",
    "@aws-sdk/lib-storage": "npm:@aws-sdk/lib-storage@3.980.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing/bdd": "jsr:@std/testing@1.0.17/bdd",
    "veryfront/errors": "../../src/errors/index.ts",
    "veryfront/extensions": "../../src/extensions/index.ts",
    "veryfront/workflow/blob": "../../src/workflow/blob/index.ts"
  },
  "tasks": {
    "test": "deno test --frozen --allow-env=AWS_LAMBDA_BENCHMARK_MODE,AWS_LAMBDA_FUNCTION_NAME,AWS_LAMBDA_MAX_CONCURRENCY,AWS_LAMBDA_NODEJS_NO_GLOBAL_AWSLAMBDA,AWS_NEW_RETRIES_2026,AWS_SDK_JS_NODE_VERSION_SUPPORT_WARNING_DISABLED,SMITHY_NEW_RETRIES_2026,_X_AMZN_TRACE_ID src/"
  }
}
