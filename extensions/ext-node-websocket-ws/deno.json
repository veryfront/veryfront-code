{
  "name": "@veryfront/ext-node-websocket-ws",
  "version": "0.1.0",
  "exports": "./src/index.ts",
  "veryfront": {
    "extension": true,
    "activation": "auto",
    "contracts": {
      "provides": [
        "NodeWebSocketServerProvider"
      ]
    },
    "capabilities": [
      {
        "type": "env:read",
        "keys": [
          "WS_NO_BUFFER_UTIL",
          "WS_NO_UTF_8_VALIDATE"
        ]
      }
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@types/ws": "npm:@types/ws@8.18.1",
    "veryfront/extensions": "../../src/extensions/index.ts",
    "veryfront/extensions/websocket": "../../src/extensions/websocket/index.ts",
    "ws": "npm:ws@8.21.1"
  },
  "tasks": {
    "check": "deno check src/index.ts src/*.test.ts",
    "test": "deno test --allow-env=WS_NO_BUFFER_UTIL,WS_NO_UTF_8_VALIDATE --allow-read=deno.json src/"
  }
}
