import { defineConfig } from 'veryfront'

const enableEvalStubTools = process.env.VERYFRONT_EVAL_STUB_TOOLS === '1'
const isProduction = process.env.NODE_ENV === 'production' || process.env.VERYFRONT_ENV === 'production'

if (enableEvalStubTools && isProduction) {
  throw new Error('VERYFRONT_EVAL_STUB_TOOLS is eval-only and must not be enabled in production')
}

const toolDiscoveryPaths = enableEvalStubTools ? ['tools', 'eval-support/tools'] : ['tools']

export default defineConfig({
  ai: {
    tools: {
      discovery: {
        paths: toolDiscoveryPaths,
      },
    },
  },
})
