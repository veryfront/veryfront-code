{
  "name": "veryfront-agent",
  "version": "0.1.36",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch main.ts",
    "build": "esbuild main.ts --bundle --platform=node --format=esm --outfile=dist/server/main.js --packages=external",
    "start": "node dist/server/main.js",
    "eval:list": "veryfront eval --list",
    "eval:smoke": "VERYFRONT_EVAL_STUB_TOOLS=1 veryfront eval veryfront-agent-reference --report-dir .veryfront/evals/veryfront-agent-reference",
    "eval:tool-loading:status": "tsx evals/tool-loading/runToolLoadingBenchmarkStatus.ts",
    "eval:tool-loading:benchmark": "tsx evals/tool-loading/runToolLoadingBenchmark.ts",
    "eval:primitive:starter-intake": "tsx evals/live/runPrimitiveStarterIntakeEval.ts",
    "eval:live": "tsx evals/live/runLiveAgUiEvals.ts",
    "eval:durable-staging": "tsx evals/durable-staging/runDurableStagingCanaries.ts",
    "eval:preflight": "node --input-type=module -e \"const { evaluateRuntimeConfidenceEnv, printRuntimeConfidencePreflight } = await import('veryfront/eval/agent-service'); const result = evaluateRuntimeConfidenceEnv(process.env); printRuntimeConfidencePreflight(result); process.exit(result.ok ? 0 : 1)\"",
    "eval:runtime-confidence": "npm run eval:preflight && npm run eval:live && npm run eval:durable-staging",
    "test": "vitest run --project unit --silent=true",
    "test:evals": "vitest run --project evals --silent=true",
    "test:all": "npm run test && npm run test:evals",
    "test:coverage": "vitest run --project unit --project evals --coverage",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check main.ts veryfront.config.ts tests evals eval-support",
    "lint:fix": "biome check --write main.ts veryfront.config.ts tests evals eval-support",
    "verify": "npm run typecheck && npm run lint && npm run test:all",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.78.0",
    "@opentelemetry/context-async-hooks": "2.9.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@veryfront/ext-auth-jwt": "0.1.1176",
    "@veryfront/ext-observability-opentelemetry": "0.1.1176",
    "@veryfront/ext-observability-sentry": "0.1.1176",
    "@veryfront/ext-sandbox-shell-tools": "0.1.1176",
    "ai": "6.0.208",
    "veryfront": "0.1.1176"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "gcp-metadata@8.1.3": {
      "gaxios": "7.1.4"
    },
    "brace-expansion": "5.0.8",
    "protobufjs": "7.6.5",
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.2.0"
    }
  }
}
