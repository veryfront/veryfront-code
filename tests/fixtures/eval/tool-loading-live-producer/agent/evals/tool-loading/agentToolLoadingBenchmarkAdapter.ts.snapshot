import type { Agent, AgentResponse } from 'veryfront/agent'

export type AgentToolLoadingBenchmarkObservation = {
  step: number
  authorizedSearchableSchemaCount: number
  visibleSchemaCount: number
  deferredSchemaCount: number
  providerRequestToolDefinitionCount: number
  providerWireDeferredMetadataCount: number
  loadingPath: 'eager' | 'framework-fallback' | 'provider-native'
}

type AgentToolLoadingBenchmarkModule = {
  runAgentToolLoadingBenchmark: (
    assistant: Agent,
    input: Parameters<Agent['generate']>[0],
    controls: {
      toolLoading?: 'eager' | 'deferred'
      observer?: (observation: AgentToolLoadingBenchmarkObservation) => void
    }
  ) => Promise<AgentResponse>
  runWithAgentToolLoadingBenchmarkRequestContext: <TResult>(
    context: {
      projectSlug: string
      projectId?: string
      authToken: string
    },
    operation: () => Promise<TResult>
  ) => Promise<TResult>
}

const benchmarkModuleSpecifier = 'veryfront/_internal/agent-tool-loading-benchmark'
let benchmarkModule: Promise<AgentToolLoadingBenchmarkModule> | undefined

export type AgentToolLoadingBenchmarkCapability =
  | {
      available: true
      status: 'ready'
      releaseGateCapability: 'complete-request-shape-capture'
    }
  | {
      available: false
      status: 'blocked'
      releaseGateCapability: 'unavailable'
      blocker: string
    }

function isAgentToolLoadingBenchmarkModule(value: unknown): value is AgentToolLoadingBenchmarkModule {
  return (
    typeof value === 'object' &&
    value !== null &&
    'runAgentToolLoadingBenchmark' in value &&
    typeof value.runAgentToolLoadingBenchmark === 'function' &&
    'runWithAgentToolLoadingBenchmarkRequestContext' in value &&
    typeof value.runWithAgentToolLoadingBenchmarkRequestContext === 'function'
  )
}

async function importBenchmarkModule(): Promise<unknown> {
  return import(benchmarkModuleSpecifier)
}

async function validatedBenchmarkModule(loadModule: () => Promise<unknown>): Promise<AgentToolLoadingBenchmarkModule> {
  const loaded = await loadModule()
  if (!isAgentToolLoadingBenchmarkModule(loaded)) {
    throw new Error('Installed Veryfront benchmark adapter does not expose the required runtime functions')
  }
  return loaded
}

async function loadBenchmarkModule(): Promise<AgentToolLoadingBenchmarkModule> {
  benchmarkModule ??= validatedBenchmarkModule(importBenchmarkModule)
  return benchmarkModule
}

export async function inspectAgentToolLoadingBenchmarkCapability(
  loadModule: () => Promise<unknown> = importBenchmarkModule
): Promise<AgentToolLoadingBenchmarkCapability> {
  try {
    await validatedBenchmarkModule(loadModule)
    return {
      available: true,
      status: 'ready',
      releaseGateCapability: 'complete-request-shape-capture',
    }
  } catch (error) {
    return {
      available: false,
      status: 'blocked',
      releaseGateCapability: 'unavailable',
      blocker: error instanceof Error ? error.message : String(error),
    }
  }
}

export async function runAgentToolLoadingBenchmark(
  ...args: Parameters<AgentToolLoadingBenchmarkModule['runAgentToolLoadingBenchmark']>
): Promise<AgentResponse> {
  return (await loadBenchmarkModule()).runAgentToolLoadingBenchmark(...args)
}

export async function runWithAgentToolLoadingBenchmarkRequestContext<TResult>(
  context: {
    projectSlug: string
    projectId?: string
    authToken: string
  },
  operation: () => Promise<TResult>
): Promise<TResult> {
  return (await loadBenchmarkModule()).runWithAgentToolLoadingBenchmarkRequestContext(context, operation)
}
