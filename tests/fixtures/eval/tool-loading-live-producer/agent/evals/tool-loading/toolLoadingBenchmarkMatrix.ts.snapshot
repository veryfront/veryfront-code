export type ToolLoadingBenchmarkMode = 'eager' | 'deferred'
export type ToolLoadingBenchmarkPrompt = 'hi' | 'Hello'

export type ToolLoadingBenchmarkAttempt = {
  prompt: ToolLoadingBenchmarkPrompt
  mode: ToolLoadingBenchmarkMode
}

const attempts = [
  { prompt: 'hi', mode: 'eager' },
  { prompt: 'hi', mode: 'deferred' },
  { prompt: 'Hello', mode: 'eager' },
  { prompt: 'Hello', mode: 'deferred' },
] satisfies ToolLoadingBenchmarkAttempt[]

/** Discover once, then execute the fixed four-call live benchmark matrix against that snapshot. */
export async function runToolLoadingBenchmarkMatrix<TSnapshot, TResult>(input: {
  discover: () => Promise<TSnapshot>
  execute: (snapshot: TSnapshot, attempt: ToolLoadingBenchmarkAttempt) => Promise<TResult>
}): Promise<TResult[]> {
  const snapshot = await input.discover()
  const results: TResult[] = []
  for (const attempt of attempts) {
    results.push(await input.execute(snapshot, attempt))
  }
  return results
}
