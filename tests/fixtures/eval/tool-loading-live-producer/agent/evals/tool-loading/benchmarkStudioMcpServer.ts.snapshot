import type { AgentHttpMcpServerConfig, NodeVeryfrontCloudAgentServiceMcpServer } from 'veryfront/agent'

export const BENCHMARK_STUDIO_TOOL_NAMES = [
  'studio_open_project',
  'studio_panel_control',
  'studio_suggestions',
  'studio_todo_write',
]

type BenchmarkStudioMcpEnvironment = {
  VERYFRONT_STUDIO_MCP_URL?: string
  VERYFRONT_TOKEN?: string
  VERYFRONT_API_TOKEN?: string
}

function requireBenchmarkEnvironmentValue(
  environment: BenchmarkStudioMcpEnvironment,
  name: keyof BenchmarkStudioMcpEnvironment
): string {
  const value = environment[name]?.trim()
  if (value) return value

  const error = new Error(`${name} is required for the standalone tool-loading benchmark`)
  error.name = 'BenchmarkConfigurationError'
  throw error
}

/**
 * Explicit benchmark-only Studio MCP transport.
 *
 * URL and bearer credentials stay deferred so discovery/config serialization
 * cannot materialize or persist the token.
 */
export function createBenchmarkStudioMcpServer(
  environment: BenchmarkStudioMcpEnvironment = process.env
): AgentHttpMcpServerConfig {
  return {
    id: 'veryfront-studio-benchmark-http',
    kind: 'http',
    transport: {
      type: 'http',
      url: () => requireBenchmarkEnvironmentValue(environment, 'VERYFRONT_STUDIO_MCP_URL'),
    },
    auth: {
      type: 'bearer',
      token: () => requireBenchmarkEnvironmentValue(environment, 'VERYFRONT_TOKEN'),
    },
    toolPolicy: {
      allow: [...BENCHMARK_STUDIO_TOOL_NAMES],
      approval: 'never',
    },
  }
}

/** Hosted-assembly view of the same explicit benchmark-only Studio transport. */
export function createBenchmarkHostedStudioMcpServer(
  environment: BenchmarkStudioMcpEnvironment = process.env
): NodeVeryfrontCloudAgentServiceMcpServer {
  return {
    id: 'veryfront-studio-benchmark-http',
    kind: 'generic',
    endpoint: () => requireBenchmarkEnvironmentValue(environment, 'VERYFRONT_STUDIO_MCP_URL'),
    headers: () => ({
      Authorization: `Bearer ${requireBenchmarkEnvironmentValue(environment, 'VERYFRONT_TOKEN')}`,
    }),
    toolPolicy: {
      allow: [...BENCHMARK_STUDIO_TOOL_NAMES],
      approval: 'never',
    },
  }
}
