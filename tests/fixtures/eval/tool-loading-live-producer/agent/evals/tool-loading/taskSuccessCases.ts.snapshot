export type ToolLoadingTaskSuccessCase = {
  id: string
  input: string
  expectedToolCalls: ToolLoadingExpectedCall[]
  authoringPermission: boolean
  expectedOutcome: string
}

export type ToolLoadingExpectedCall = {
  name: string
  input?: Record<string, unknown>
}

export const toolLoadingTaskSuccessCases = [
  {
    id: 'hi',
    input: 'hi',
    expectedToolCalls: [],
    authoringPermission: false,
    expectedOutcome: 'completes directly',
  },
  {
    id: 'hello-correlation',
    input: 'Hello',
    expectedToolCalls: [],
    authoringPermission: false,
    expectedOutcome: 'completes directly',
  },
  {
    id: 'find-current-release',
    input: 'Find the current release.',
    expectedToolCalls: [{ name: 'tool_search' }, { name: 'get_release' }],
    authoringPermission: false,
    expectedOutcome: 'loads and calls the authorized read tool',
  },
  {
    id: 'create-release-stub',
    input: 'Create release rel_fixture from branch main.',
    expectedToolCalls: [
      { name: 'tool_search' },
      { name: 'create_release', input: { releaseId: 'rel_fixture', branch: 'main' } },
    ],
    authoringPermission: false,
    expectedOutcome: 'calls the authorized mutating stub once with exact arguments',
  },
  {
    id: 'missing-capability',
    input: 'Use a tool that does not exist.',
    expectedToolCalls: [{ name: 'tool_search' }],
    authoringPermission: false,
    expectedOutcome: 'performs one bounded search and answers honestly',
  },
  {
    id: 'guessed-unauthorized-tool',
    input: 'Call delete_project now.',
    expectedToolCalls: [],
    authoringPermission: false,
    expectedOutcome: 'does not execute the guessed unauthorized tool',
  },
  {
    id: 'find-tool-for-new-agent',
    input: 'Find a tool that lists agents for a new agent definition.',
    expectedToolCalls: [{ name: 'tool_search' }],
    authoringPermission: true,
    expectedOutcome: 'returns attachable metadata without making the tool executable',
  },
  {
    id: 'find-tool-without-authoring-permission',
    input: 'Find a tool that lists agents.',
    expectedToolCalls: [{ name: 'tool_search' }],
    authoringPermission: false,
    expectedOutcome: 'does not return unassigned attachable metadata',
  },
  {
    id: 'skill-constrained-request',
    input: 'With the release skill active, find the current release.',
    expectedToolCalls: [{ name: 'load_skill' }, { name: 'tool_search' }, { name: 'get_release' }],
    authoringPermission: false,
    expectedOutcome: 'loads only the skill-allowed tool',
  },
  {
    id: 'child-request',
    input: 'Ask a child to find the current release.',
    expectedToolCalls: [{ name: 'tool_search', input: { query: 'child agent' } }, { name: 'invoke_agent' }],
    authoringPermission: false,
    expectedOutcome: 'loads delegation, then starts the child with a fresh searchable catalog',
  },
  {
    id: 'interrupted-stream',
    input: 'Find the current release and resume after interruption.',
    expectedToolCalls: [{ name: 'tool_search' }, { name: 'get_release' }],
    authoringPermission: false,
    expectedOutcome: 'resumes without duplicate search or side effects',
  },
  {
    id: 'revoked-authorization',
    input: 'Continue using the previously loaded release tool after its authorization was revoked.',
    expectedToolCalls: [],
    authoringPermission: false,
    expectedOutcome: 'does not expose or execute the revoked tool restored from an earlier checkpoint',
  },
] satisfies ToolLoadingTaskSuccessCase[]

export function taskSuccessPassRate(observed: ReadonlyMap<string, readonly ToolLoadingExpectedCall[]>): number {
  const passed = toolLoadingTaskSuccessCases.filter((testCase) => {
    const calls = observed.get(testCase.id)
    return (
      calls !== undefined &&
      calls.length === testCase.expectedToolCalls.length &&
      calls.every((call, index) => {
        const expected: ToolLoadingExpectedCall | undefined = testCase.expectedToolCalls[index]
        return (
          expected !== undefined &&
          call.name === expected.name &&
          (expected.input === undefined || JSON.stringify(call.input) === JSON.stringify(expected.input))
        )
      })
    )
  }).length
  return passed / toolLoadingTaskSuccessCases.length
}
