export type BenchmarkProducerIdentity = {
  revision: string
  tree: string
  clean: true
}

type RegistryFrameworkPackageIdentity = {
  version: string
  integrity: string
  source: 'package-lock'
}

type LocalPackFrameworkPackageIdentity = {
  version: string
  integrity: string
  source: 'local-npm-pack'
  tarballPath: string
  tarballSha256: string
  registryDependencyVersion: string
  registryLockIntegrity: string
  frameworkRevision: string
  frameworkTree: string
  frameworkSourceClean: true
}

export type BenchmarkFrameworkPackageIdentity = RegistryFrameworkPackageIdentity | LocalPackFrameworkPackageIdentity

type BenchmarkRecord = {
  prompt: BenchmarkPrompt
  mode: BenchmarkMode
  model: string
  executionModel: string
  sourceRevision: string
  sourceTree: string
  catalogFingerprint: string
  catalogSourceRevision: string
  catalogSourceTree: string
  configuredToolNames: string[]
  effectiveAuthorizedToolNames: string[]
  authorizedToolDefinitions: AuthorizedToolDefinition[]
  configuredToolNameCount: number
  effectiveAuthorizedToolNameCount: number
  authorizedSearchableSchemaCount?: number
  visibleSchemaCount?: number
  deferredSchemaCount?: number
  providerRequestToolDefinitionCount?: number
  providerWireDeferredMetadataCount?: number
  requestShapeCaptureStatus: 'complete' | 'unavailable'
  loadingPath?: AgentToolLoadingBenchmarkObservation['loadingPath']
  inputTokens?: number
  cacheCreationInputTokens?: number
  cacheReadInputTokens?: number
  billableInputTokens?: number
  effectiveInputTokens?: number
  providerInputCostUsd?: number
  usageCaptureStatus: 'complete' | 'partial' | 'missing'
  steps: number
  toolCalls: number
  durationMs: number
  completed: boolean
  errorCode?: string
  errorMessage?: string
}

type BenchmarkComparison = {
  prompt: BenchmarkPrompt
  status: 'passed' | 'failed' | 'incomplete'
  effectiveInputReduction?: number
  eager: BenchmarkRecord
  deferred: BenchmarkRecord
  assertions: Array<{
    name: string
    status: 'passed' | 'failed' | 'incomplete'
    actual?: number | string | boolean
    expected: string
  }>
}

type LiveCanaryRecord = {
  id: 'authorized-read-only-canary'
  prompt: string
  mode: 'deferred'
  completed: boolean
  expectedToolName: 'list_projects'
  producer: BenchmarkProducerIdentity
  frameworkPackage: BenchmarkFrameworkPackageIdentity
  observedToolCalls: Array<{
    name: string
    status: 'pending' | 'executing' | 'completed' | 'error'
    input: Record<string, unknown>
    result: unknown
    error?: string
  }>
  status: 'passed' | 'failed'
  errorCode?: string
  errorMessage?: string
}

const execFileAsync = promisify(execFile)
const model = 'anthropic/claude-opus-4-6'
const executionModel = 'veryfront-cloud/anthropic/claude-opus-4-6'
const reportJsonPath = '.veryfront/evals/tool-loading/live/report.json'
const reportMarkdownPath = '.veryfront/evals/tool-loading/live/report.md'
const statusPath = '.veryfront/evals/tool-loading/status.json'
const configuredTimeoutMs = Number(process.env.VERYFRONT_TOOL_LOADING_TIMEOUT_MS ?? '120000')
const timeoutMs = Number.isFinite(configuredTimeoutMs) && configuredTimeoutMs > 0 ? configuredTimeoutMs : 120_000

export async function resolveBenchmarkProducerIdentity(
  projectDir: string,
  runGit: (args: string[]) => Promise<string> = async (args) => {
    const result = await execFileAsync('git', args, { cwd: projectDir })
    return result.stdout
  }
): Promise<BenchmarkProducerIdentity> {
  const revision = (await runGit(['rev-parse', 'HEAD'])).trim()
  const tree = (await runGit(['rev-parse', 'HEAD^{tree}'])).trim()
  const configuredRevision = process.env.GIT_COMMIT_SHA?.trim()
  if (configuredRevision && configuredRevision !== revision) {
    throw new Error(`GIT_COMMIT_SHA ${configuredRevision} does not match benchmark producer HEAD ${revision}`)
  }
  const dirty = await runGit(['status', '--porcelain=v1', '--untracked-files=all'])
  if (dirty.trim()) {
    const paths = dirty
      .trimEnd()
      .split('\n')
      .slice(0, 20)
      .map((entry) => entry.slice(3))
      .join(', ')
    throw new Error(
      `Tool-loading live benchmark requires a clean committed producer; commit or remove these changes first: ${paths}`
    )
  }
  return { revision, tree, clean: true }
}

function jsonRecord(value: unknown, label: string): Record<string, unknown> {
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    throw new Error(`${label} must be a JSON object`)
  }
  return Object.fromEntries(Object.entries(value))
}

function stringField(record: Record<string, unknown>, name: string, label: string): string {
  const value = record[name]
  if (typeof value !== 'string' || !value.trim()) {
    throw new Error(`${label}.${name} must be a non-empty string`)
  }
  return value
}

async function directoryContentFingerprint(root: string): Promise<string> {
  const hash = createHash('sha256')
  const visit = async (directory: string): Promise<void> => {
    const entries = (await readdir(directory, { withFileTypes: true })).sort((left, right) =>
      left.name.localeCompare(right.name)
    )
    for (const entry of entries) {
      const path = resolve(directory, entry.name)
      const relativePath = relative(root, path).replaceAll('\\', '/')
      if (relativePath === 'node_modules' || relativePath.startsWith('node_modules/')) continue
      if (entry.isDirectory()) {
        hash.update(`directory\0${relativePath}\0`)
        await visit(path)
      } else if (entry.isSymbolicLink()) {
        hash.update(`symlink\0${relativePath}\0${await readlink(path)}\0`)
      } else if (entry.isFile()) {
        hash.update(`file\0${relativePath}\0`)
        hash.update(await readFile(path))
        hash.update('\0')
      } else {
        throw new Error(`Unsupported package entry while fingerprinting ${relativePath}`)
      }
    }
  }
  await visit(root)
  return hash.digest('hex')
}

async function tarballPackageContentFingerprint(tarballPath: string): Promise<string> {
  const extractDirectory = await mkdtemp(resolve(tmpdir(), 'veryfront-framework-pack-'))
  try {
    await execFileAsync('tar', ['-xzf', tarballPath, '-C', extractDirectory])
    return await directoryContentFingerprint(resolve(extractDirectory, 'package'))
  } finally {
    await rm(extractDirectory, { recursive: true, force: true })
  }
}

export async function installedPackageMatchesTarball(
  tarballPath: string,
  installedPackagePath: string
): Promise<boolean> {
  return (
    (await tarballPackageContentFingerprint(tarballPath)) === (await directoryContentFingerprint(installedPackagePath))
  )
}

async function frameworkSourceMatchesTarball(frameworkSourceDir: string, tarballPath: string): Promise<boolean> {
  const packDirectory = await mkdtemp(resolve(tmpdir(), 'veryfront-framework-source-pack-'))
  try {
    const result = await execFileAsync('npm', ['pack', '--silent', '--pack-destination', packDirectory], {
      cwd: resolve(frameworkSourceDir, 'npm'),
    })
    const packedFileName = result.stdout
      .trim()
      .split(/\r?\n/)
      .findLast((line) => line.endsWith('.tgz'))
    if (!packedFileName) throw new Error('npm pack did not report a framework tarball')
    return (
      (await tarballPackageContentFingerprint(resolve(packDirectory, packedFileName))) ===
      (await tarballPackageContentFingerprint(tarballPath))
    )
  } finally {
    await rm(packDirectory, { recursive: true, force: true })
  }
}

export async function resolveBenchmarkFrameworkPackageIdentity(
  projectDir: string,
  dependencies: {
    environment?: Record<string, string | undefined>
    readText?: (path: string) => Promise<string>
    readBytes?: (path: string) => Promise<Uint8Array>
    isSymbolicLink?: (path: string) => Promise<boolean>
    runGit?: (sourceDir: string, args: string[]) => Promise<string>
    verifyInstalledPackageMatchesTarball?: (tarballPath: string, installedPackagePath: string) => Promise<boolean>
    verifyFrameworkSourceMatchesTarball?: (frameworkSourceDir: string, tarballPath: string) => Promise<boolean>
  } = {}
): Promise<BenchmarkFrameworkPackageIdentity> {
  const environment = dependencies.environment ?? process.env
  const readText = dependencies.readText ?? ((path: string) => readFile(path, 'utf8'))
  const readBytes = dependencies.readBytes ?? ((path: string) => readFile(path))
  const frameworkPath = resolve(projectDir, 'node_modules/veryfront')
  const isSymbolicLink = dependencies.isSymbolicLink ?? (async (path: string) => (await lstat(path)).isSymbolicLink())
  if (await isSymbolicLink(frameworkPath)) {
    throw new Error(
      'Tool-loading live benchmark requires a non-symlinked installed veryfront package; replace the linked framework package before running'
    )
  }

  const projectPackage = jsonRecord(JSON.parse(await readText(resolve(projectDir, 'package.json'))), 'package.json')
  const projectDependencies = jsonRecord(projectPackage.dependencies, 'package.json.dependencies')
  const expectedVersion = stringField(projectDependencies, 'veryfront', 'package.json.dependencies')
  const packageLock = jsonRecord(
    JSON.parse(await readText(resolve(projectDir, 'package-lock.json'))),
    'package-lock.json'
  )
  const lockPackages = jsonRecord(packageLock.packages, 'package-lock.json.packages')
  const lockRoot = jsonRecord(lockPackages[''], 'package-lock root entry')
  const lockRootDependencies = jsonRecord(lockRoot.dependencies, 'package-lock root dependencies')
  const lockedDependency = stringField(lockRootDependencies, 'veryfront', 'package-lock root dependencies')
  const lockedPackage = jsonRecord(lockPackages['node_modules/veryfront'], 'package-lock veryfront entry')
  const lockedVersion = stringField(lockedPackage, 'version', 'package-lock veryfront entry')
  const integrity = stringField(lockedPackage, 'integrity', 'package-lock veryfront entry')
  const installedPackage = jsonRecord(
    JSON.parse(await readText(resolve(frameworkPath, 'package.json'))),
    'installed veryfront package.json'
  )
  const installedVersion = stringField(installedPackage, 'version', 'installed veryfront package.json')

  const configuredPackPath = environment.VERYFRONT_FRAMEWORK_PACK_PATH?.trim()
  if (configuredPackPath) {
    if (expectedVersion !== lockedDependency || expectedVersion !== lockedVersion) {
      throw new Error(
        `Registry dependency must remain clean for a local Veryfront npm pack: package.json=${expectedVersion}, package-lock dependency=${lockedDependency}, package-lock=${lockedVersion}`
      )
    }
    const tarballPath = resolve(projectDir, configuredPackPath)
    if (!tarballPath.endsWith('.tgz')) {
      throw new Error('VERYFRONT_FRAMEWORK_PACK_PATH must identify an npm pack .tgz artifact')
    }
    const tarballBytes = await readBytes(tarballPath)
    const tarballSha256 = createHash('sha256').update(tarballBytes).digest('hex')
    const tarballIntegrity = `sha512-${createHash('sha512').update(tarballBytes).digest('base64')}`
    const expectedTarballSha256 = environment.VERYFRONT_FRAMEWORK_PACK_SHA256?.trim().toLowerCase()
    const expectedTarballIntegrity = environment.VERYFRONT_FRAMEWORK_PACK_INTEGRITY?.trim()
    if (!expectedTarballSha256 || !/^[a-f0-9]{64}$/.test(expectedTarballSha256)) {
      throw new Error('VERYFRONT_FRAMEWORK_PACK_SHA256 must be the expected 64-character local npm pack sha256')
    }
    if (tarballSha256 !== expectedTarballSha256) {
      throw new Error(
        `Local Veryfront npm pack sha256 mismatch: expected=${expectedTarballSha256}, actual=${tarballSha256}`
      )
    }
    if (!expectedTarballIntegrity || tarballIntegrity !== expectedTarballIntegrity) {
      throw new Error(
        `Local Veryfront npm pack integrity mismatch: expected=${expectedTarballIntegrity ?? 'missing'}, actual=${tarballIntegrity}`
      )
    }
    const verifyInstalledPackageMatchesTarball =
      dependencies.verifyInstalledPackageMatchesTarball ?? installedPackageMatchesTarball
    if (!(await verifyInstalledPackageMatchesTarball(tarballPath, frameworkPath))) {
      throw new Error('Installed Veryfront package contents do not match the attested local npm pack artifact')
    }
    const sourceDirectory = environment.VERYFRONT_FRAMEWORK_SOURCE_DIR?.trim()
    const expectedRevision = environment.VERYFRONT_FRAMEWORK_GIT_REVISION?.trim()
    const expectedTree = environment.VERYFRONT_FRAMEWORK_GIT_TREE?.trim()
    if (!sourceDirectory || !expectedRevision || !expectedTree) {
      throw new Error(
        'Local Veryfront npm pack requires VERYFRONT_FRAMEWORK_SOURCE_DIR, VERYFRONT_FRAMEWORK_GIT_REVISION, and VERYFRONT_FRAMEWORK_GIT_TREE'
      )
    }
    const frameworkSourceDir = resolve(projectDir, sourceDirectory)
    const runGit =
      dependencies.runGit ??
      (async (sourceDir: string, args: string[]) => {
        const result = await execFileAsync('git', args, { cwd: sourceDir })
        return result.stdout
      })
    const frameworkRevision = (await runGit(frameworkSourceDir, ['rev-parse', 'HEAD'])).trim()
    const frameworkTree = (await runGit(frameworkSourceDir, ['rev-parse', 'HEAD^{tree}'])).trim()
    const dirty = await runGit(frameworkSourceDir, ['status', '--porcelain=v1', '--untracked-files=all'])
    if (dirty.trim()) {
      throw new Error('Local Veryfront npm pack requires a clean committed framework source worktree')
    }
    if (frameworkRevision !== expectedRevision || frameworkTree !== expectedTree) {
      throw new Error(
        `Local Veryfront framework Git identity mismatch: expected=${expectedRevision}/${expectedTree}, actual=${frameworkRevision}/${frameworkTree}`
      )
    }
    const verifyFrameworkSourceMatchesTarball =
      dependencies.verifyFrameworkSourceMatchesTarball ?? frameworkSourceMatchesTarball
    if (!(await verifyFrameworkSourceMatchesTarball(frameworkSourceDir, tarballPath))) {
      throw new Error('Attested Veryfront npm pack contents do not match the exact framework source build')
    }
    return {
      version: installedVersion,
      integrity: tarballIntegrity,
      source: 'local-npm-pack',
      tarballPath,
      tarballSha256,
      registryDependencyVersion: expectedVersion,
      registryLockIntegrity: integrity,
      frameworkRevision,
      frameworkTree,
      frameworkSourceClean: true,
    }
  }

  if (
    expectedVersion !== lockedDependency ||
    expectedVersion !== lockedVersion ||
    expectedVersion !== installedVersion
  ) {
    throw new Error(
      `Veryfront framework version mismatch: package.json=${expectedVersion}, package-lock dependency=${lockedDependency}, package-lock=${lockedVersion}, installed=${installedVersion}`
    )
  }
  return { version: expectedVersion, integrity, source: 'package-lock' }
}

type BenchmarkMainDependencies<TSnapshot> = {
  projectDir: string
  producerIdentity: () => Promise<BenchmarkProducerIdentity>
  frameworkPackageIdentity: () => Promise<BenchmarkFrameworkPackageIdentity>
  loadExamples: () => Promise<Array<{ id: string; input: unknown }>>
  discover: () => Promise<TSnapshot>
  execute: (
    snapshot: TSnapshot,
    prompt: BenchmarkPrompt,
    mode: BenchmarkMode,
    producer: BenchmarkProducerIdentity
  ) => Promise<BenchmarkRecord>
  executeCanary: (
    snapshot: TSnapshot,
    producer: BenchmarkProducerIdentity,
    frameworkPackage: BenchmarkFrameworkPackageIdentity
  ) => Promise<LiveCanaryRecord>
  runDeterministicGate?: () => Promise<DeterministicRuntimeGateResult>
  cleanupSnapshot?: (snapshot: TSnapshot) => Promise<void>
  projectIdentities?: (snapshot: TSnapshot) => string[]
  mkdir: (path: string, options: { recursive: true }) => Promise<unknown>
  writeFile: (path: string, contents: string) => Promise<unknown>
  writeOutput: (output: string) => void
}

export function sanitizeBenchmarkErrorMessage(message: string, projectIdentities: readonly string[] = []): string {
  const redacted = redactSensitiveString(message, projectIdentities).replace(/\s+/g, ' ').trim()

  return (redacted || 'Unknown error').slice(0, 1_000)
}

function redactSensitiveString(value: string, projectIdentities: readonly string[]): string {
  const identityRedacted = [...projectIdentities]
    .filter(Boolean)
    .sort((left, right) => right.length - left.length)
    .reduce(
      (current, identity) =>
        current
          .replaceAll(identity, '[REDACTED_PROJECT_ID]')
          .replaceAll(encodeURIComponent(identity), '[REDACTED_PROJECT_ID]'),
      value
    )
  return identityRedacted
    .replace(/\bBearer\s+[A-Za-z0-9._~+/=-]+/gi, 'Bearer [REDACTED]')
    .replace(
      /(\b(?:api[_-]?(?:key|token)|auth[_-]?token|access[_-]?token|refresh[_-]?token|token)\b\s*[:=]\s*)(?:"[^"]*"|'[^']*'|[^\s,;&]+)/gi,
      '$1[REDACTED]'
    )
    .replace(/\beyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\b/g, '[REDACTED_JWT]')
}

export function benchmarkErrorFields(
  error: unknown,
  projectIdentities: readonly string[] = []
): Pick<BenchmarkRecord, 'errorCode' | 'errorMessage'> {
  return {
    errorCode: error instanceof Error ? error.name : 'UnknownError',
    errorMessage: sanitizeBenchmarkErrorMessage(
      error instanceof Error ? error.message : String(error),
      projectIdentities
    ),
  }
}

function canonicalJsonValue(
  value: unknown,
  label: string,
  sanitizeString: (value: string) => string = (entry) => entry,
  ancestors = new WeakSet<object>()
): unknown {
  if (typeof value === 'string') return sanitizeString(value)
  if (value === null || typeof value === 'boolean') return value
  if (typeof value === 'number') {
    return Number.isFinite(value) ? value : null
  }
  if (Array.isArray(value)) {
    if (ancestors.has(value)) throw new Error(`${label} contains a cycle`)
    ancestors.add(value)
    try {
      return Array.from(value, (entry, index) => {
        const entryType = typeof entry
        return entry === undefined || entryType === 'function' || entryType === 'symbol'
          ? null
          : canonicalJsonValue(entry, `${label}[${index}]`, sanitizeString, ancestors)
      })
    } finally {
      ancestors.delete(value)
    }
  }
  if (typeof value === 'object') {
    if (ancestors.has(value)) throw new Error(`${label} contains a cycle`)
    ancestors.add(value)
    try {
      return Object.fromEntries(
        Object.entries(value)
          .filter(([, entry]) => {
            const entryType = typeof entry
            return entry !== undefined && entryType !== 'function' && entryType !== 'symbol'
          })
          .sort(([left], [right]) => left.localeCompare(right))
          .map(([key, entry]) => [key, canonicalJsonValue(entry, `${label}.${key}`, sanitizeString, ancestors)])
      )
    } finally {
      ancestors.delete(value)
    }
  }
  throw new Error(`${label} contains an unsupported ${typeof value} value`)
}

export function fingerprintAuthorizedToolDefinitions(definitions: AuthorizedToolDefinition[]): string {
  const canonicalDefinitions = [...definitions]
    .sort((left, right) => left.name.localeCompare(right.name))
    .map((definition, index) => canonicalJsonValue(definition, `authorizedToolDefinitions[${index}]`))
  return `sha256:${createHash('sha256').update(JSON.stringify(canonicalDefinitions)).digest('hex')}`
}

export function sanitizePersistedBenchmarkValue(value: unknown, projectIdentities: readonly string[]): unknown {
  return canonicalJsonValue(value, 'benchmarkReport', (entry) => redactSensitiveString(entry, projectIdentities))
}

export function sanitizeLiveCanaryToolResult(
  toolName: string,
  result: unknown,
  projectIdentities: readonly string[] = []
): unknown {
  if (toolName !== 'list_projects') {
    return canonicalJsonValue(result, `${toolName}.result`, (value) => redactSensitiveString(value, projectIdentities))
  }

  const record = optionalRecord(result)
  const structuredContent = optionalRecord(record?.structuredContent)
  const projects = [record?.projects, record?.data, structuredContent?.projects, structuredContent?.data].find(
    Array.isArray
  )
  const pageInfoValue =
    record?.pageInfo ?? record?.page_info ?? structuredContent?.pageInfo ?? structuredContent?.page_info
  const pageInfo = optionalRecord(pageInfoValue)
  const hasNextPage =
    typeof pageInfo?.hasNextPage === 'boolean'
      ? pageInfo.hasNextPage
      : Object.hasOwn(pageInfo ?? {}, 'next')
        ? pageInfo?.next !== null
        : undefined

  return {
    kind: 'list_projects_summary',
    ...(projects ? { projectCount: projects.length } : {}),
    hasPageInfo: pageInfo !== undefined,
    ...(hasNextPage !== undefined ? { hasNextPage } : {}),
  }
}

function optionalRecord(value: unknown): Record<string, unknown> | undefined {
  return typeof value === 'object' && value !== null && !Array.isArray(value)
    ? Object.fromEntries(Object.entries(value))
    : undefined
}

export function createReadOnlyCanaryToolSurface(
  binding: Pick<EffectiveHostedBenchmarkBinding, 'effectiveToolNames' | 'mcpServers'>
): {
  tools: { list_projects: true }
  mcpServers: AgentMcpServerConfig[]
} {
  if (!binding.effectiveToolNames.includes('list_projects')) {
    throw new Error('Authorized read-only canary tool list_projects is absent from the effective hosted binding')
  }
  const mcpServers = binding.mcpServers
    .filter((server) => server.toolPolicy?.allow?.includes('list_projects'))
    .map(
      (server): AgentMcpServerConfig => ({
        ...server,
        toolPolicy: {
          allow: ['list_projects'],
          approval: 'never',
        },
      })
    )
  if (mcpServers.length === 0) {
    throw new Error('Authorized read-only canary tool list_projects has no isolated remote tool source')
  }
  return {
    tools: { list_projects: true },
    mcpServers,
  }
}

export function isExactReadOnlyCanarySequence(
  calls: ReadonlyArray<{ name: string; status: 'pending' | 'executing' | 'completed' | 'error' }>
): boolean {
  return (
    calls.length === 2 &&
    calls[0]?.name === 'tool_search' &&
    calls[0].status === 'completed' &&
    calls[1]?.name === 'list_projects' &&
    calls[1].status === 'completed'
  )
}

export function sanitizeLiveCanaryToolCall(
  call: {
    name: string
    status: 'pending' | 'executing' | 'completed' | 'error'
    args: Record<string, unknown>
    result?: unknown
    error?: string
  },
  projectIdentities: readonly string[]
): LiveCanaryRecord['observedToolCalls'][number] {
  const sanitizedError = call.error ? sanitizeBenchmarkErrorMessage(call.error, projectIdentities) : undefined
  return {
    name: call.name,
    status: call.status,
    input: call.args,
    result:
      call.result !== undefined
        ? sanitizeLiveCanaryToolResult(call.name, call.result, projectIdentities)
        : (sanitizedError ?? null),
    ...(sanitizedError ? { error: sanitizedError } : {}),
  }
}

function requestShapeFields(
  observation: AgentToolLoadingBenchmarkObservation | undefined
): Pick<
  BenchmarkRecord,
  | 'authorizedSearchableSchemaCount'
  | 'visibleSchemaCount'
  | 'deferredSchemaCount'
  | 'providerRequestToolDefinitionCount'
  | 'providerWireDeferredMetadataCount'
  | 'requestShapeCaptureStatus'
  | 'loadingPath'
> {
  if (!observation) return { requestShapeCaptureStatus: 'unavailable' }
  return {
    authorizedSearchableSchemaCount: observation.authorizedSearchableSchemaCount,
    visibleSchemaCount: observation.visibleSchemaCount,
    deferredSchemaCount: observation.deferredSchemaCount,
    providerRequestToolDefinitionCount: observation.providerRequestToolDefinitionCount,
    providerWireDeferredMetadataCount: observation.providerWireDeferredMetadataCount,
    requestShapeCaptureStatus: 'complete',
    loadingPath: observation.loadingPath,
  }
}

function benchmarkProjectIdentities(binding: EffectiveHostedBenchmarkBinding): string[] {
  return [
    binding.executionContext.projectId,
    ...(binding.executionContext.projectSlug ? [binding.executionContext.projectSlug] : []),
  ]
}

async function runRecord(
  snapshot: {
    runtime: ProjectAgentRuntimeDiscovery
    binding: EffectiveHostedBenchmarkBinding
  },
  prompt: BenchmarkPrompt,
  mode: BenchmarkMode,
  producer: BenchmarkProducerIdentity
): Promise<BenchmarkRecord> {
  const startedAt = performance.now()
  const configuredToolNames = [...snapshot.binding.configuredToolNames].sort()
  const effectiveAuthorizedToolNames = [...snapshot.binding.effectiveToolNames].sort()
  const authorizedToolDefinitions = [...snapshot.binding.authorizedToolDefinitions].sort((left, right) =>
    left.name.localeCompare(right.name)
  )
  const catalogFingerprint = fingerprintAuthorizedToolDefinitions(authorizedToolDefinitions)
  let latestObservation: AgentToolLoadingBenchmarkObservation | undefined
  try {
    const canonicalAgent = snapshot.runtime.agents.get('veryfront')
    if (!canonicalAgent) throw new Error('Canonical agent was not discovered')

    const benchmarkAgent = agent({
      ...canonicalAgent.config,
      system: snapshot.binding.system,
      tools: snapshot.binding.tools,
      mcpServers: snapshot.binding.mcpServers,
    })
    const abortController = new AbortController()
    const generateInput = {
      input: prompt,
      model: executionModel,
      abortSignal: abortController.signal,
      context: snapshot.binding.executionContext,
    }
    let providerTimeoutHandle: ReturnType<typeof setTimeout> | undefined
    const providerTimeout = new Promise<never>((_resolve, reject) => {
      providerTimeoutHandle = setTimeout(() => {
        abortController.abort()
        const error = new Error(`Provider call exceeded ${timeoutMs}ms`)
        error.name = 'BenchmarkTimeout'
        reject(error)
      }, timeoutMs)
    })
    const providerCall = runWithProjectAgentRuntime(snapshot.runtime, () =>
      runAgentToolLoadingBenchmark(benchmarkAgent, generateInput, {
        toolLoading: mode,
        observer: (observation) => {
          latestObservation = observation
        },
      })
    )
    const response = await Promise.race([providerCall, providerTimeout]).finally(() => {
      if (providerTimeoutHandle) clearTimeout(providerTimeoutHandle)
    })
    const inputTokens = response.usage?.promptTokens
    const cacheCreationInputTokens = response.usage?.cacheCreationInputTokens
    const cacheReadInputTokens = response.usage?.cacheReadInputTokens
    const effectiveInputTokens =
      inputTokens === undefined
        ? undefined
        : inputTokens + (cacheCreationInputTokens ?? 0) + (cacheReadInputTokens ?? 0)
    const steps = Math.max(1, response.messages.filter((message) => message.role === 'assistant').length)
    return {
      prompt,
      mode,
      model,
      executionModel,
      sourceRevision: producer.revision,
      sourceTree: producer.tree,
      catalogFingerprint,
      catalogSourceRevision: producer.revision,
      catalogSourceTree: producer.tree,
      configuredToolNames,
      effectiveAuthorizedToolNames,
      authorizedToolDefinitions,
      configuredToolNameCount: configuredToolNames.length,
      effectiveAuthorizedToolNameCount: effectiveAuthorizedToolNames.length,
      ...requestShapeFields(latestObservation),
      ...(inputTokens !== undefined ? { inputTokens } : {}),
      ...(cacheCreationInputTokens !== undefined ? { cacheCreationInputTokens } : {}),
      ...(cacheReadInputTokens !== undefined ? { cacheReadInputTokens } : {}),
      ...(response.usage?.billableInputTokens !== undefined
        ? { billableInputTokens: response.usage.billableInputTokens }
        : {}),
      ...(effectiveInputTokens !== undefined ? { effectiveInputTokens } : {}),
      ...(response.usage?.providerInputCostUsd !== undefined
        ? { providerInputCostUsd: response.usage.providerInputCostUsd }
        : {}),
      usageCaptureStatus: response.usage?.usageCaptureStatus ?? 'missing',
      steps,
      toolCalls: response.toolCalls.length,
      durationMs: Math.round(performance.now() - startedAt),
      completed: response.status === 'completed',
    }
  } catch (error) {
    return {
      prompt,
      mode,
      model,
      executionModel,
      sourceRevision: producer.revision,
      sourceTree: producer.tree,
      catalogFingerprint,
      catalogSourceRevision: producer.revision,
      catalogSourceTree: producer.tree,
      configuredToolNames,
      effectiveAuthorizedToolNames,
      authorizedToolDefinitions,
      configuredToolNameCount: configuredToolNames.length,
      effectiveAuthorizedToolNameCount: effectiveAuthorizedToolNames.length,
      ...requestShapeFields(latestObservation),
      usageCaptureStatus: 'missing',
      steps: 0,
      toolCalls: 0,
      durationMs: Math.round(performance.now() - startedAt),
      completed: false,
      ...benchmarkErrorFields(error, benchmarkProjectIdentities(snapshot.binding)),
    }
  }
}

async function runAuthorizedReadOnlyCanary(
  snapshot: {
    runtime: ProjectAgentRuntimeDiscovery
    binding: EffectiveHostedBenchmarkBinding
  },
  producer: BenchmarkProducerIdentity,
  frameworkPackage: BenchmarkFrameworkPackageIdentity
): Promise<LiveCanaryRecord> {
  const prompt =
    'Use tool_search to load the authorized list_projects read-only tool, call list_projects exactly once, then summarize the result.'
  try {
    const canonicalAgent = snapshot.runtime.agents.get('veryfront')
    if (!canonicalAgent) throw new Error('Canonical agent was not discovered')
    const canarySurface = createReadOnlyCanaryToolSurface(snapshot.binding)
    const canaryAgent = agent({
      ...canonicalAgent.config,
      system: snapshot.binding.system,
      tools: canarySurface.tools,
      providerTools: [],
      mcpServers: canarySurface.mcpServers,
    })
    const abortController = new AbortController()
    let providerTimeoutHandle: ReturnType<typeof setTimeout> | undefined
    const providerTimeout = new Promise<never>((_resolve, reject) => {
      providerTimeoutHandle = setTimeout(() => {
        abortController.abort()
        const error = new Error(`Provider call exceeded ${timeoutMs}ms`)
        error.name = 'BenchmarkTimeout'
        reject(error)
      }, timeoutMs)
    })
    const providerCall = runWithProjectAgentRuntime(snapshot.runtime, () =>
      runAgentToolLoadingBenchmark(
        canaryAgent,
        {
          input: prompt,
          model: executionModel,
          abortSignal: abortController.signal,
          context: snapshot.binding.executionContext,
        },
        { toolLoading: 'deferred' }
      )
    )
    const response = await Promise.race([providerCall, providerTimeout]).finally(() => {
      if (providerTimeoutHandle) clearTimeout(providerTimeoutHandle)
    })
    const observedToolCalls = response.toolCalls.map((call) =>
      sanitizeLiveCanaryToolCall(call, benchmarkProjectIdentities(snapshot.binding))
    )
    const status =
      response.status === 'completed' && isExactReadOnlyCanarySequence(observedToolCalls) ? 'passed' : 'failed'
    return {
      id: 'authorized-read-only-canary',
      prompt,
      mode: 'deferred',
      completed: response.status === 'completed',
      expectedToolName: 'list_projects',
      producer,
      frameworkPackage,
      observedToolCalls,
      status,
    }
  } catch (error) {
    return {
      id: 'authorized-read-only-canary',
      prompt,
      mode: 'deferred',
      completed: false,
      expectedToolName: 'list_projects',
      producer,
      frameworkPackage,
      observedToolCalls: [],
      status: 'failed',
      ...benchmarkErrorFields(error, benchmarkProjectIdentities(snapshot.binding)),
    }
  }
}

function compare(prompt: BenchmarkPrompt, eager: BenchmarkRecord, deferred: BenchmarkRecord): BenchmarkComparison {
  const reduction =
    eager.effectiveInputTokens !== undefined &&
    deferred.effectiveInputTokens !== undefined &&
    eager.effectiveInputTokens > 0
      ? (eager.effectiveInputTokens - deferred.effectiveInputTokens) / eager.effectiveInputTokens
      : undefined
  const assertions: BenchmarkComparison['assertions'] = []
  const assert = (name: string, pass: boolean, actual: number | string | boolean, expected: string) => {
    assertions.push({ name, status: pass ? 'passed' : 'failed', actual, expected })
  }
  const incomplete = (name: string, expected: string) => {
    assertions.push({ name, status: 'incomplete', expected })
  }

  assert('underlying-model-controlled', eager.model === deferred.model, deferred.model, eager.model)
  assert(
    'execution-model-controlled',
    eager.executionModel === deferred.executionModel,
    deferred.executionModel,
    eager.executionModel
  )
  assert(
    'veryfront-cloud-transport',
    [eager, deferred].every((record) => record.executionModel.startsWith('veryfront-cloud/')),
    `${eager.executionModel}, ${deferred.executionModel}`,
    'veryfront-cloud/* for eager and deferred'
  )
  assert(
    'producer-revision-controlled',
    eager.sourceRevision === deferred.sourceRevision,
    deferred.sourceRevision,
    eager.sourceRevision
  )
  assert('producer-tree-controlled', eager.sourceTree === deferred.sourceTree, deferred.sourceTree, eager.sourceTree)
  const usageComplete = [eager, deferred].every(
    (record) =>
      record.usageCaptureStatus === 'complete' &&
      record.inputTokens !== undefined &&
      record.cacheCreationInputTokens !== undefined &&
      record.cacheReadInputTokens !== undefined &&
      record.billableInputTokens !== undefined &&
      record.providerInputCostUsd !== undefined
  )
  usageComplete
    ? assert('usage-capture-complete', true, true, 'complete for eager and deferred')
    : incomplete('usage-capture-complete', 'complete for eager and deferred')
  const requestShapeComplete =
    eager.requestShapeCaptureStatus === 'complete' && deferred.requestShapeCaptureStatus === 'complete'
  requestShapeComplete
    ? assert('request-shape-capture-complete', true, true, 'complete for eager and deferred')
    : incomplete(
        'request-shape-capture-complete',
        'framework-produced authorized, visible, deferred, model-context, and provider-wire counts'
      )
  deferred.effectiveInputTokens === undefined
    ? incomplete('deferred-effective-input-limit', '<= 10000')
    : assert(
        'deferred-effective-input-limit',
        deferred.effectiveInputTokens <= 10_000,
        deferred.effectiveInputTokens,
        '<= 10000'
      )
  reduction === undefined
    ? incomplete('effective-input-reduction', '>= 0.60')
    : assert('effective-input-reduction', reduction >= 0.6, reduction, '>= 0.60')
  eager.providerInputCostUsd === undefined || deferred.providerInputCostUsd === undefined
    ? incomplete('provider-input-cost-lower', 'deferred < eager')
    : assert(
        'provider-input-cost-lower',
        deferred.providerInputCostUsd < eager.providerInputCostUsd,
        deferred.providerInputCostUsd,
        `< ${eager.providerInputCostUsd}`
      )
  for (const record of [eager, deferred]) {
    assert(`${record.mode}-completed`, record.completed, record.completed, 'true')
    assert(`${record.mode}-one-step`, record.steps === 1, record.steps, '1')
    assert(`${record.mode}-no-tool-calls`, record.toolCalls === 0, record.toolCalls, '0')
  }
  if (
    eager.providerRequestToolDefinitionCount === undefined ||
    deferred.providerRequestToolDefinitionCount === undefined
  ) {
    incomplete('model-context-definitions-reduced', 'deferred < eager')
  } else {
    assert(
      'model-context-definitions-reduced',
      deferred.providerRequestToolDefinitionCount < eager.providerRequestToolDefinitionCount,
      deferred.providerRequestToolDefinitionCount,
      `< ${eager.providerRequestToolDefinitionCount}`
    )
  }
  if (eager.authorizedSearchableSchemaCount === undefined || deferred.authorizedSearchableSchemaCount === undefined) {
    incomplete('authorized-catalog-preserved', 'deferred == eager')
  } else {
    assert(
      'authorized-catalog-preserved',
      deferred.authorizedSearchableSchemaCount === eager.authorizedSearchableSchemaCount,
      deferred.authorizedSearchableSchemaCount,
      `${eager.authorizedSearchableSchemaCount}`
    )
  }
  if (eager.catalogFingerprint === 'sha256:unavailable' || deferred.catalogFingerprint === 'sha256:unavailable') {
    incomplete('catalog-fingerprint-preserved', 'same non-empty fingerprint')
  } else {
    assert(
      'catalog-fingerprint-preserved',
      deferred.catalogFingerprint === eager.catalogFingerprint,
      deferred.catalogFingerprint,
      eager.catalogFingerprint
    )
  }
  assert(
    'exact-authorized-catalog-controlled',
    JSON.stringify(deferred.effectiveAuthorizedToolNames) === JSON.stringify(eager.effectiveAuthorizedToolNames),
    deferred.effectiveAuthorizedToolNames.length,
    `${eager.effectiveAuthorizedToolNames.length} exact ordered names`
  )
  assert(
    'exact-configured-catalog-controlled',
    JSON.stringify(deferred.configuredToolNames) === JSON.stringify(eager.configuredToolNames),
    deferred.configuredToolNames.length,
    `${eager.configuredToolNames.length} exact ordered names`
  )

  const status = assertions.some((item) => item.status === 'incomplete')
    ? 'incomplete'
    : assertions.some((item) => item.status === 'failed')
      ? 'failed'
      : 'passed'
  return {
    prompt,
    status,
    ...(reduction !== undefined ? { effectiveInputReduction: reduction } : {}),
    eager,
    deferred,
    assertions,
  }
}

function markdown(
  comparisons: BenchmarkComparison[],
  deterministicGate: DeterministicRuntimeGateResult,
  canary: LiveCanaryRecord | undefined,
  status: string,
  producer: BenchmarkProducerIdentity,
  frameworkPackage: BenchmarkFrameworkPackageIdentity
): string {
  const lines = [
    '# Veryfront agent tool-loading benchmark',
    '',
    `Status: \`${status}\``,
    '',
    `Producer commit: \`${producer.revision}\``,
    '',
    `Producer tree: \`${producer.tree}\``,
    '',
    'Producer worktree: `clean`',
    '',
    `Framework package: \`${frameworkPackage.version}\``,
    '',
    `Framework package integrity: \`${frameworkPackage.integrity}\``,
    '',
    ...(frameworkPackage.source === 'local-npm-pack'
      ? [
          `Framework source commit: \`${frameworkPackage.frameworkRevision}\``,
          '',
          `Framework source tree: \`${frameworkPackage.frameworkTree}\``,
          '',
          `Framework npm pack sha256: \`${frameworkPackage.tarballSha256}\``,
          '',
          `Committed registry dependency: \`${frameworkPackage.registryDependencyVersion}\``,
          '',
          `Committed registry lock integrity: \`${frameworkPackage.registryLockIntegrity}\``,
          '',
        ]
      : []),
    `Underlying model: \`${model}\``,
    '',
    `Execution model: \`${executionModel}\``,
    '',
    '## Deterministic runtime gate',
    '',
    `Status: \`${deterministicGate.status}\` (${deterministicGate.executedCaseCount} executed, ${(
      deterministicGate.passRate * 100
    ).toFixed(0)}% passed)`,
    '',
    '| Case | Status | Observed calls |',
    '| --- | --- | --- |',
    ...deterministicGate.cases.map(
      (testCase) =>
        `| ${testCase.id} | ${testCase.status} | ${
          testCase.observedToolCalls.map((call) => `${call.name}:${call.status}`).join(', ') || 'none'
        } |`
    ),
    '',
  ]
  for (const comparison of comparisons) {
    lines.push(
      `## ${comparison.prompt}`,
      '',
      `Status: \`${comparison.status}\``,
      '',
      '| Measurement | Eager | Deferred |',
      '| --- | ---: | ---: |',
      `| Effective input tokens | ${comparison.eager.effectiveInputTokens ?? '-'} | ${
        comparison.deferred.effectiveInputTokens ?? '-'
      } |`,
      `| Provider input cost USD | ${comparison.eager.providerInputCostUsd ?? '-'} | ${
        comparison.deferred.providerInputCostUsd ?? '-'
      } |`,
      `| Configured tool names | ${comparison.eager.configuredToolNameCount} | ${comparison.deferred.configuredToolNameCount} |`,
      `| Effective authorized tool names | ${comparison.eager.effectiveAuthorizedToolNameCount} | ${comparison.deferred.effectiveAuthorizedToolNameCount} |`,
      `| Authorized schemas | ${comparison.eager.authorizedSearchableSchemaCount ?? '-'} | ${
        comparison.deferred.authorizedSearchableSchemaCount ?? '-'
      } |`,
      `| Visible schemas | ${comparison.eager.visibleSchemaCount ?? '-'} | ${
        comparison.deferred.visibleSchemaCount ?? '-'
      } |`,
      `| Deferred schemas | ${comparison.eager.deferredSchemaCount ?? '-'} | ${
        comparison.deferred.deferredSchemaCount ?? '-'
      } |`,
      `| Model-context tool definitions | ${comparison.eager.providerRequestToolDefinitionCount ?? '-'} | ${
        comparison.deferred.providerRequestToolDefinitionCount ?? '-'
      } |`,
      `| Provider HTTP wire deferred metadata | ${comparison.eager.providerWireDeferredMetadataCount ?? '-'} | ${
        comparison.deferred.providerWireDeferredMetadataCount ?? '-'
      } |`,
      `| Loading path | ${comparison.eager.loadingPath ?? '-'} | ${comparison.deferred.loadingPath ?? '-'} |`,
      `| Steps | ${comparison.eager.steps} | ${comparison.deferred.steps} |`,
      `| Tool calls | ${comparison.eager.toolCalls} | ${comparison.deferred.toolCalls} |`,
      `| Duration ms | ${comparison.eager.durationMs} | ${comparison.deferred.durationMs} |`,
      `| Error | ${comparison.eager.errorMessage?.replaceAll('|', '\\|') ?? '-'} | ${
        comparison.deferred.errorMessage?.replaceAll('|', '\\|') ?? '-'
      } |`,
      ''
    )
  }
  lines.push(
    '## Authorized read-only live canary',
    '',
    canary
      ? `Status: \`${canary.status}\`; expected \`${canary.expectedToolName}\`; observed ${
          canary.observedToolCalls.map((call) => `${call.name}:${call.status}`).join(', ') || 'no calls'
        }.`
      : 'Status: `not-run` because the deterministic runtime gate did not pass.',
    ''
  )
  return `${lines.join('\n')}\n`
}

async function runBenchmarkMain<TSnapshot>(dependencies: BenchmarkMainDependencies<TSnapshot>): Promise<number> {
  const producer = await dependencies.producerIdentity()
  const frameworkPackage = await dependencies.frameworkPackageIdentity()
  const deterministicGate = await (dependencies.runDeterministicGate ?? runDeterministicToolLoadingRuntimeGate)()
  const comparisons: BenchmarkComparison[] = []
  const evalExamples = await dependencies.loadExamples()
  const livePrompts: BenchmarkPrompt[] = []
  for (const example of evalExamples) {
    if (example.id === 'hi' && example.input === 'hi') livePrompts.push('hi')
    if (example.id === 'hello-correlation' && example.input === 'Hello') livePrompts.push('Hello')
  }
  if (livePrompts.length !== 2) {
    throw new Error('Canonical tool-loading eval must contain exact hi and Hello live prompts')
  }
  let liveCanary: LiveCanaryRecord | undefined
  let projectIdentities: string[] = []
  if (deterministicGate.status === 'passed') {
    let discoveredSnapshot: TSnapshot | undefined
    let liveRecords: BenchmarkRecord[]
    try {
      liveRecords = await runToolLoadingBenchmarkMatrix({
        discover: async () => {
          discoveredSnapshot = await dependencies.discover()
          return discoveredSnapshot
        },
        execute: (snapshot, attempt) => dependencies.execute(snapshot, attempt.prompt, attempt.mode, producer),
      })
      if (discoveredSnapshot === undefined) throw new Error('Benchmark discovery did not produce a runtime snapshot')
      projectIdentities = dependencies.projectIdentities?.(discoveredSnapshot) ?? []
      liveCanary = await dependencies.executeCanary(discoveredSnapshot, producer, frameworkPackage)
      if (
        JSON.stringify(liveCanary.producer) !== JSON.stringify(producer) ||
        JSON.stringify(liveCanary.frameworkPackage) !== JSON.stringify(frameworkPackage)
      ) {
        throw new Error('Live canary identity does not match the benchmark producer and installed framework')
      }
    } finally {
      if (discoveredSnapshot !== undefined) {
        await dependencies.cleanupSnapshot?.(discoveredSnapshot)
      }
    }
    for (const prompt of livePrompts) {
      const eager = liveRecords.find((record) => record.prompt === prompt && record.mode === 'eager')
      const deferred = liveRecords.find((record) => record.prompt === prompt && record.mode === 'deferred')
      if (!eager || !deferred) throw new Error(`Benchmark matrix did not produce both modes for ${prompt}`)
      comparisons.push(compare(prompt, eager, deferred))
    }
  }
  const status =
    deterministicGate.status === 'failed' || liveCanary?.status === 'failed'
      ? 'failed'
      : comparisons.some((comparison) => comparison.status === 'incomplete')
        ? 'incomplete'
        : comparisons.some((comparison) => comparison.status === 'failed')
          ? 'failed'
          : 'passed'
  const report = {
    kind: 'veryfront-agent-tool-loading-benchmark',
    evalId: toolLoadingEval.id,
    status,
    model,
    executionModel,
    producer,
    frameworkPackage,
    liveCalls: deterministicGate.status === 'passed' ? 5 : 0,
    comparisonLiveCalls: deterministicGate.status === 'passed' ? 4 : 0,
    canaryLiveCalls: liveCanary ? 1 : 0,
    deterministicTaskSuccessCases: deterministicGate.executedCaseCount,
    deterministicGate,
    liveCanary,
    reportJsonPath,
    reportMarkdownPath,
    comparisons,
  }
  const persistedReport = sanitizePersistedBenchmarkValue(report, projectIdentities)
  for (const path of [reportJsonPath, reportMarkdownPath, statusPath]) {
    await dependencies.mkdir(dirname(resolve(dependencies.projectDir, path)), { recursive: true })
  }
  await dependencies.writeFile(
    resolve(dependencies.projectDir, reportJsonPath),
    `${JSON.stringify(persistedReport, null, 2)}\n`
  )
  await dependencies.writeFile(
    resolve(dependencies.projectDir, reportMarkdownPath),
    markdown(comparisons, deterministicGate, liveCanary, status, producer, frameworkPackage)
  )
  await dependencies.writeFile(
    resolve(dependencies.projectDir, statusPath),
    `${JSON.stringify(
      {
        kind: 'veryfront-agent-tool-loading-benchmark-status',
        status,
        model,
        executionModel,
        reportJsonPath,
        reportMarkdownPath,
      },
      null,
      2
    )}\n`
  )
  dependencies.writeOutput(`${JSON.stringify({ status, reportJsonPath, reportMarkdownPath }, null, 2)}\n`)
  return status === 'passed' ? 0 : 1
}

async function runDefaultBenchmark(environment: DirectBenchmarkEnvironment): Promise<number> {
  const projectDir = process.cwd()
  return runBenchmarkMain({
    projectDir,
    producerIdentity: () => resolveBenchmarkProducerIdentity(projectDir),
    frameworkPackageIdentity: () => resolveBenchmarkFrameworkPackageIdentity(projectDir),
    loadExamples: () => toolLoadingEval.dataset.load({ baseDir: projectDir }),
    discover: async () => {
      const runtime = await discoverProjectAgentRuntime({ projectDir })
      const binding = await createEffectiveHostedBenchmarkBinding({ runtime, environment })
      return { runtime, binding }
    },
    execute: (snapshot, prompt, mode, revision) => runRecord(snapshot, prompt, mode, revision),
    executeCanary: (snapshot, producer, frameworkPackage) =>
      runAuthorizedReadOnlyCanary(snapshot, producer, frameworkPackage),
    cleanupSnapshot: (snapshot) => snapshot.binding.cleanup(),
    projectIdentities: (snapshot) => benchmarkProjectIdentities(snapshot.binding),
    mkdir,
    writeFile,
    writeOutput: (output) => process.stdout.write(output),
  })
}

function requiredDirectBenchmarkValue(environment: DirectBenchmarkEnvironment, name: string): string {
  const value = environment[name]?.trim()
  if (value) return value
  throw new Error(`${name} is required for the standalone tool-loading benchmark`)
}

export async function runDirectBenchmark(
  environment: DirectBenchmarkEnvironment = process.env,
  dependencies: {
    runWithProjectContext?: typeof runWithAgentToolLoadingBenchmarkRequestContext
    runBenchmark?: () => Promise<number>
  } = {}
): Promise<number> {
  const projectId = requiredDirectBenchmarkValue(environment, 'AG_UI_EVAL_PROJECT_ID')
  const projectSlug = requiredDirectBenchmarkValue(environment, 'VERYFRONT_PROJECT_SLUG')
  const authToken = requiredDirectBenchmarkValue(environment, 'VERYFRONT_TOKEN')
  const runWithProjectContext = dependencies.runWithProjectContext ?? runWithAgentToolLoadingBenchmarkRequestContext
  const runBenchmark = dependencies.runBenchmark ?? (() => runDefaultBenchmark(environment))
  return runWithProjectContext({ projectSlug, projectId, authToken }, runBenchmark)
}

export async function main<TSnapshot>(dependencies?: BenchmarkMainDependencies<TSnapshot>): Promise<number> {
  if (dependencies) return runBenchmarkMain(dependencies)
  return runDirectBenchmark()
}

const isDirectRun = process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url)

if (isDirectRun) {
  void main()
    .then((exitCode) => {
      process.exit(exitCode)
    })
    .catch((error) => {
      console.error(error instanceof Error ? error.message : String(error))
      process.exit(1)
    })
}
