# Snowflake Integration
# Create a programmatic access token (PAT) in Snowsight under your user profile
SNOWFLAKE_PAT=your_programmatic_access_token
# Your Snowflake account identifier (e.g., xy12345.us-east-1)
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# Default warehouse for compute resources
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# Optional: Default database and schema
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=PUBLIC
