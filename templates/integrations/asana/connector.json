    {
      "id": "asana__get_task",
      "name": "Get Task",
      "description": "Get task",
      "requiresWrite": false,
      "endpoint": {
        "method": "GET",
        "url": "https://app.asana.com/api/1.0/tasks/{taskGid}",
        "params": {
          "taskGid": {
            "type": "string",
            "in": "path",
            "description": "Asana task GID",
            "required": true
          },
          "opt_fields": {
            "type": "string",
            "in": "query",
            "description": "Comma-separated task fields to return"
          }
        },
        "response": {
          "transform": "data"
        }
