# Veryfront Server - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.

# Proxy API Configuration
VERYFRONT_PROXY_API_BASE_URL=https://api.veryfront.com

# Single Project Mode (deno task production)
VERYFRONT_API_TOKEN=
VERYFRONT_PROJECT_SLUG=

# Headless Mode (deno task start --headless) / Split Mode (deno task start-split)
# OAuth credentials for proxy to fetch project tokens
VERYFRONT_PROXY_API_CLIENT_ID=
VERYFRONT_PROXY_API_CLIENT_SECRET=
REDIS_URL=

# Proxy Mode (deployed pods)
# Set PROXY_MODE=1 only for hosted/deployed runtimes.
# Requires NODE_ENV=production, a valid signing key, and a private runtime
# behind an edge that strips client-supplied forwarding/project headers.
# PROXY_MODE=1
# NODE_ENV=production
# CHANNEL_DISPATCH_SIGNING_PUBLIC_KEY=
# Required (exactly "1") for hosted proxy mode; the runtime refuses to boot
# without it. Set it only when the process is private behind a sanitising
# edge. Rollout order for existing deployments: set this variable first, then
# deploy the proxy tier, then the runtime tier. See src/security/README.md
# ("Rollout ordering for hosted identity changes").
# VERYFRONT_TRUST_FORWARDED_HEADERS=1

# Host outbound network policy
# Remote modules and remote MCP calls may reach public HTTP(S) endpoints. The
# runtime rejects loopback, private, link-local, metadata, and other non-global
# destinations, including after DNS resolution and on every redirect hop.
#
# Emergency compatibility override. This disables that host SSRF ceiling and
# must remain unset in shared runtimes. Project environment overlays cannot set
# this host-owned option.
# VERYFRONT_HOST_ALLOW_INTERNAL_EGRESS=1

# Grants the host-execution capability to a shared runtime that is intended to
# be the project executor. Tenant project code then runs in the shared host
# process; per-request separation is source scoping, not a tenant boundary.
# Leave unset to require an external or dedicated isolated project runtime.
# Project environment overlays cannot set this host-owned option.
# VERYFRONT_HOST_ALLOW_PROJECT_EXECUTION=1

# Grants this host permission to resolve and use credentials for local
# integration tools. Set the exact value 1 only on a local or dedicated
# self-hosted runtime. Leave it unset on shared, hosted, and proxy runtimes.
# Veryfront does not infer deployment shape; this exact grant authorizes the
# current non-proxy process.
# Project environment overlays cannot set this host-owned option.
# VERYFRONT_HOST_ALLOW_LOCAL_INTEGRATION_CREDENTIALS=1

# Required privileged environment-value retrieval for hosted proxy runtimes.
# Deploy the canonical /internal/project-environment-variables endpoint before
# setting both values on the runtime process. The runtime first verifies the
# request-scoped bearer token and never falls back if this endpoint fails.
# Leave both values unset for local CLI proxy mode and non-proxy runtimes.
# VERYFRONT_API_INTERNAL_USER=
# VERYFRONT_API_INTERNAL_PASS=

# Render overload protection
# Maximum requests allowed to wait behind one identical cacheable render.
# Additional followers receive a retryable 503 until the shared render settles.
# RENDER_SINGLEFLIGHT_MAX_FOLLOWERS=20

# Binary compilation
# Set to 1 to always rebuild binary, even if source unchanged
VERYFRONT_BINARY_FRESH=1

# OpenTelemetry (optional - host-owned in shared/proxy runtime)
# In shared/proxy runtime, set these only on the platform process. Project env
# overlays cannot choose the shared runtime collector endpoint or credentials.
# In dedicated runtime, these may be project/deployment env vars because the
# project has its own process boundary.
# VERYFRONT_OTEL=1
# OTEL_TRACES_ENABLED=true
# OTEL_METRICS_ENABLED=true
# OTEL_SERVICE_NAME=veryfront-server
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...

# Logging (debug | info | warn | error)
LOG_LEVEL=info
